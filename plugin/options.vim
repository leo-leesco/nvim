set number
set relativenumber
set cursorline

set showmatch " shows corresponding bracket
set matchtime=3

set termguicolors

set mouse=a

set ignorecase
set smartcase

set list
set listchars=tab:→\ ,trail:∙,nbsp:⋅

set completeopt=fuzzy,menu,popup,noselect

set wrap
set linebreak
set breakindent
set scrolloff=5

set splitbelow

set gdefault ":s replaces all occurences on whole lines, use :s//g to turn off

